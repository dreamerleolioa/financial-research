ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-5

FINMIND_REQUESTS_PER_HOUR=600
FINMIND_ANONYMOUS_REQUESTS_PER_HOUR=300
FINMIND_MAX_CONCURRENT_REQUESTS=8
FINMIND_HOLDING_SHARES_PER_ENABLED=false
FINMIND_API_TOKEN=token

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:5173/login/callback

DAILY_RADAR_INTERNAL_TOKEN=your-token
